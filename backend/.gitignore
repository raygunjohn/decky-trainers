# --- Rust build output -----------------------------------------------------
# 2.8 GB in a normal build tree. Never commit it.
/target/
**/*.rs.bk
*.pdb

# --- Containerized build scratch --------------------------------------------
# Working tree copy used by the podman build (this host has no native cc; see
# CLAUDE.md's "Build and generate"). A full duplicate of the repo, resynced on
# every build. Never source.
/.build-cache/

# --- Generated trainers ----------------------------------------------------
# Output of ct2trainer. These are built artifacts: a ~2.3 MB PE per table,
# regenerated by the command in CLAUDE.md.
/dist/
*.trainer.exe

# --- Staged stub resources -------------------------------------------------
# ct2trainer finds the
# cargo-built stubs directly, so these only exist if a stub was staged by hand
# or lifted from a CE install. Never source.
standalonephase1.dat
standalonephase2.dat
*.dat

# --- Runtime scratch -------------------------------------------------------
# The trainer unpacks itself here at run time; only relevant if a stray copy
# ends up in the tree.
deckytrainers/
cetrainers/
HTT_*/
CET_*/
extracted/

# --- Analysis and debug output --------------------------------------------
*.log
sweep.log
watch.log
verify-*.txt
/scratch/

# --- Editor / OS -----------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
